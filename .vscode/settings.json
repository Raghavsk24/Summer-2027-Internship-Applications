{
    // Delete all LaTeX build artifacts after every build (success or failure),
    // leaving only the .tex source and the compiled .pdf.
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "latex-workshop.latex.clean.method": "glob",
    "latex-workshop.latex.clean.subfolder.enabled": true,
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux", "*.bbl", "*.blg", "*.bcf", "*.run.xml",
        "*.idx", "*.ind", "*.ilg", "*.lof", "*.lot", "*.toc", "*.out",
        "*.acn", "*.acr", "*.alg", "*.glg", "*.glo", "*.gls", "*.ist",
        "*.fls", "*.log", "*.fdb_latexmk", "*.xdv", "*.dvi",
        "*.snm", "*.nav", "*.vrb",
        "*.synctex", "*.synctex.gz", "*.synctex(busy)", "*.synctex.gz(busy)"
    ]
}
